# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Large media files & storage clips
storage/inputs/*
storage/clips/*
storage/raw_videos/*
storage/ready_to_publish/*
storage/thumbnails/*
storage/*.zip
storage/*.mp4
storage/*.jpg
storage/*.png
storage/*.json
storage/*.pickle
storage/*.log
*.log
!storage/.gitkeep
!storage/thumbnails/.gitkeep

# Keep storage directories
!storage/inputs/.gitkeep
!storage/clips/.gitkeep
!storage/raw_videos/.gitkeep
!storage/ready_to_publish/.gitkeep

# Environment & IDE
.env
.venv/
env/
venv/
.idea/
.vscode/

# Static cache
static/preview_cache.jpg
static/current_sample_frame.jpg
